{
  "name": "@foodapp/db",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "db:codegen": "tsx --env-file=../../.env src/codegen.ts",
    "db:migrate": "tsx --env-file=../../.env src/setup.ts && pnpm db:codegen",
    "db:seed": "tsx --env-file=../../.env src/seed.ts",
    "db:seed:bundle": "tsx src/bundle-sql.ts --seeds",
    "db:migrations:bundle": "tsx src/bundle-sql.ts --migrations",
    "db:bundle": "pnpm db:migrations:bundle && pnpm db:seed:bundle",
    "format:migrations": "for f in migrations/*.sql; do sql-formatter -c sql-formatter.json --fix \"$f\"; done",
    "format:seeds": "for f in seeds/*.sql; do sql-formatter -c sql-formatter.json --fix \"$f\"; done",
    "format": "biome format --write src generated && pnpm format:migrations && pnpm format:seeds",
    "lint": "biome lint src generated",
    "fixed": "biome check --write src generated"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "sql-formatter": "^15.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
