{
  "name": "foodapp",
  "version": "1.0.0",
  "private": true,
  "description": "FoodApp Monorepo Workspace Root",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "fixed": "biome check --write .",
    "db:up": "podman compose up -d --wait",
    "db:down": "podman compose down",
    "db:drop": "podman compose down -v",
    "db:migrate": "turbo run db:migrate --filter=@foodapp/db",
    "db:seed": "turbo run db:seed --filter=@foodapp/db",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:reset": "pnpm db:drop && pnpm db:setup",
    "ai-context": "node scripts/ai-context.js"
  },
  "keywords": [],
  "author": "Shamil Khan",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "strip-comments": "^2.0.1",
    "turbo": "^2.11.10"
  }
}
