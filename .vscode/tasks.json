{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch-backend",
      "type": "shell",
      "command": "pnpm --filter @foodapp/backend dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Server is running on http://localhost:4000"
        }
      }
    },
    {
      "label": "watch-frontend",
      "type": "shell",
      "command": "pnpm --filter @foodapp/frontend dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "➜  Local:"
        }
      }
    }
  ]
}
